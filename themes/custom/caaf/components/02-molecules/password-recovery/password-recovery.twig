<section class="password-recovery" aria-labelledby="password-recovery-title">
  <div class="password-recovery__inner">
    <h1 class="password-recovery__title" id="password-recovery-title">{{ title|default('Cambiar contraseña') }}</h1>
    {% if description %}<p class="password-recovery__description">{{ description }}</p>{% endif %}

    {% if state == 'confirmation' %}
      <div class="password-recovery__notice" role="status">
        <h2>Revisa tu correo</h2>
        <p>{{ confirmation_message|default('Si los datos ingresados coinciden con una cuenta, recibirás un enlace para restablecer tu contraseña.') }}</p>
      </div>
    {% elseif state == 'expired' %}
      <div class="password-recovery__notice password-recovery__notice--error" role="alert">
        <h2>El enlace ya no está disponible</h2>
        <p>{{ expired_message|default('Este enlace de recuperación venció o ya fue utilizado.') }}</p>
        <a class="password-recovery__button" href="{{ request_url|default('/user/password') }}">Solicitar un nuevo enlace</a>
      </div>
    {% else %}
      <form class="password-recovery__form" action="{{ form_action|default('/user/password') }}" method="post">
        <div class="password-recovery__panel">
          {% include "../../01-atoms/form-input/form-input.twig" with {
            id: 'password-recovery-account',
            name: 'name',
            type: 'email',
            label: 'Email',
            icon: 'email',
            label_hidden: false,
            variant: 'outlined',
            autocomplete: 'email',
            required: true
          } only %}
        </div>
        {% include "../../01-atoms/button/button.twig" with { label: 'Enviar enlace', type: 'submit', variant: 'primary' } only %}
        <a class="password-recovery__back" href="{{ login_url|default('/user/login') }}">Regresar al inicio de sesión</a>
        {% if hidden_fields %}{{ hidden_fields }}{% endif %}
      </form>
    {% endif %}
  </div>
</section>
