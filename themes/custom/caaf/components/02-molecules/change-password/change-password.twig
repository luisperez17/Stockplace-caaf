<section class="change-password" aria-labelledby="{{ title_id|default('change-password-title') }}">
  <div class="change-password__inner">
    {% if title %}
      <h2 class="change-password__title" id="{{ title_id|default('change-password-title') }}">
        {{ title }}
      </h2>
    {% endif %}

    <form
      class="change-password__form"
      action="{{ form_action|default('#') }}"
      method="post"
      data-change-password
      data-message-required="{{ validation.required|default('Este campo es obligatorio.') }}"
      data-message-min-length="{{ validation.min_length|default('La contraseña debe tener mínimo 8 caracteres') }}"
      data-message-match="{{ validation.match|default('Las contraseñas no coinciden.') }}"
      novalidate
    >
      <div class="change-password__panel">
        {% for field in fields %}
          {% set field_id = field.id|default(field.name) %}
          <div class="change-password__field" data-change-password-field>
            {% include "../../01-atoms/form-input/form-input.twig" with field|merge({
              type: 'password',
              icon: 'lock',
              label_hidden: false,
              variant: 'outlined',
              min_length: field.min_length|default(8),
              input_role: loop.first ? 'change-password-main' : 'change-password-confirm',
              help: field.help
            }) only %}
            {% if loop.first %}
              <div class="change-password__strength" data-password-strength aria-live="polite" hidden>
                <span class="change-password__strength-bar"><span data-password-strength-bar></span></span>
                <span data-password-strength-label>Fortaleza: sin contraseña</span>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <button class="change-password__submit" type="submit">
        {{ submit_label|default('Cambiar contraseña') }}
      </button>
    </form>
  </div>
</section>
