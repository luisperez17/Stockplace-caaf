<section class="change-password" aria-labelledby="{{ title_id|default('change-password-title') }}">
  <div class="change-password__inner">
    {% if title %}
      <h2 class="change-password__title" id="{{ title_id|default('change-password-title') }}">
        {{ title }}
      </h2>
    {% endif %}

    <form
      class="change-password__form"
      action="{{ form_action|default('#') }}"
      method="post"
      data-change-password
      data-message-required="{{ validation.required|default('Este campo es obligatorio.') }}"
      data-message-min-length="{{ validation.min_length|default('La contraseña debe tener mínimo 8 caracteres') }}"
      data-message-match="{{ validation.match|default('Las contraseñas no coinciden.') }}"
      novalidate
    >
      <div class="change-password__panel">
        {% for field in fields %}
          {% set field_id = field.id|default(field.name) %}
          <div class="change-password__field" data-change-password-field>
            <label class="change-password__label" for="{{ field_id }}">
              <span class="change-password__lock" aria-hidden="true"></span>
              <span>{{ field.label }}</span>
            </label>

            <div class="change-password__input-wrap">
              <input
                class="change-password__input"
                id="{{ field_id }}"
                name="{{ field.name }}"
                type="password"
                autocomplete="{{ field.autocomplete|default('new-password') }}"
                minlength="{{ field.min_length|default(8) }}"
                aria-describedby="{{ field_id }}-message"
                data-change-password-input
                {% if loop.first %}data-change-password-main{% else %}data-change-password-confirm{% endif %}
              >
              <button
                class="change-password__toggle"
                type="button"
                aria-label="Mostrar contraseña"
                aria-pressed="false"
                data-change-password-toggle
              >
                <span class="change-password__eye" aria-hidden="true"></span>
              </button>
            </div>

            <p class="change-password__message" id="{{ field_id }}-message" data-change-password-message>
              {{ field.help }}
            </p>
          </div>
        {% endfor %}
      </div>

      <button class="change-password__submit" type="submit">
        {{ submit_label|default('Cambiar contraseña') }}
      </button>
    </form>
  </div>
</section>
