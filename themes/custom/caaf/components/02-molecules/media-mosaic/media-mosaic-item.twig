{% set bundle = item.bundle|default(item.category|default(item.type)) %}
{% set type = bundle %}
{% if bundle in ['photographic', 'fotografico'] %}
  {% set type = 'image' %}
{% elseif bundle in ['graphic', 'grafico'] %}
  {% set type = 'graphic' %}
{% elseif bundle == 'sonoro' %}
  {% set type = 'audio' %}
{% endif %}
{% set type = type|default((item.src or item.image.src) ? 'image' : 'placeholder') %}
{% set size = size|default(item.size|default('short')) %}
{% set image_src = item.src|default(item.image.src|default(item.graphic.src)) %}
{% set image_alt = item.alt|default(item.image.alt|default(item.graphic.alt|default(''))) %}
{% set poster = item.poster|default(item.video.poster) %}
{% set title = item.title|default(item.label|default(image_alt)) %}

<figure class="media-mosaic__item media-mosaic__item--{{ type }} media-mosaic__item--{{ size }}">
  {% if type in ['image', 'graphic'] and image_src %}
    <img
      class="media-mosaic__image"
      src="{{ image_src }}"
      alt="{{ image_alt }}"
      loading="{{ item.loading|default(item.image.loading|default('lazy')) }}"
    >
  {% elseif type == 'video' and poster %}
    <img
      class="media-mosaic__image"
      src="{{ poster }}"
      alt="{{ item.alt|default(item.video.alt|default('')) }}"
      loading="{{ item.loading|default('lazy') }}"
    >
    {% if item.label %}
      <figcaption class="media-mosaic__caption">{{ item.label }}</figcaption>
    {% endif %}
  {% elseif type in ['audio', 'music'] %}
    <div
      class="media-mosaic__audio"
      {% if item.gradient %}style="--media-mosaic-audio-gradient: {{ item.gradient }};"{% endif %}
      aria-hidden="true"
    >
      <span class="media-mosaic__wave"></span>
    </div>
    {% if item.label %}
      <figcaption class="media-mosaic__caption">{{ item.label }}</figcaption>
    {% endif %}
  {% else %}
    <div
      class="media-mosaic__placeholder"
      {% if item.color %}style="--media-mosaic-placeholder: {{ item.color }};"{% endif %}
      aria-hidden="true"
    ></div>
    {% if item.label %}
      <figcaption class="media-mosaic__caption">{{ item.label }}</figcaption>
    {% endif %}
  {% endif %}

  <div class="media-mosaic__overlay">
    <button
      class="media-mosaic__favorite{% if item.is_favorite %} is-active{% endif %}"
      type="button"
      aria-label="{{ item.is_favorite ? 'Quitar de favoritos' : 'Agregar a favoritos' }}"
      aria-pressed="{{ item.is_favorite ? 'true' : 'false' }}"
      data-media-mosaic-favorite
      data-label-add="Agregar a favoritos"
      data-label-remove="Quitar de favoritos"
    >
      <svg
        class="media-mosaic__favorite-icon"
        aria-hidden="true"
        viewBox="0 0 24 24"
        width="16"
        height="16"
      >
        <path class="media-mosaic__favorite-outline" d="M16.5 3c-1.74 0-3.41.81-4.5 2.09A5.98 5.98 0 0 0 7.5 3C4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3Zm-4.4 15.55-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87A3.9 3.9 0 0 1 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05Z" />
        <path class="media-mosaic__favorite-filled" d="m12 21.35-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09A5.98 5.98 0 0 1 16.5 3C19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35Z" />
      </svg>
    </button>

    {% if title or item.region %}
      <div class="media-mosaic__details">
        {% if title %}
          <strong class="media-mosaic__title">{{ title }}</strong>
        {% endif %}
        {% if item.region %}
          <span class="media-mosaic__meta">Región: {{ item.region }}</span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</figure>
