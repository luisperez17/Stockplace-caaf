{{ attach_library('caaf/stockplace-403') }}

{%
  set page_classes = [
    'section',
    'page',
    'page--stockplace-403',
  ]
%}

<div{{ attributes.addClass(page_classes) }}>
  <main class="stockplace-403" role="main">
    <a id="main-content" tabindex="-1"></a>

    <section class="stockplace-403__content" aria-labelledby="stockplace-403-title">
      <div class="stockplace-403__mark" aria-hidden="true">
        <span class="stockplace-403__mark-ring stockplace-403__mark-ring--outer"></span>
        <span class="stockplace-403__mark-ring stockplace-403__mark-ring--middle"></span>
        <span class="stockplace-403__mark-core">
          <svg class="stockplace-403__icon" viewBox="0 0 48 48" focusable="false" aria-hidden="true">
            <path d="M20.9 6.5h6.2l1.1 5.2c1.2.4 2.3.9 3.3 1.5l4.5-2.9 4.4 4.4-2.9 4.5c.6 1 1.1 2.1 1.5 3.3l5.2 1.1v6.2L39 30.9c-.4 1.2-.9 2.3-1.5 3.3l2.9 4.5-4.4 4.4-4.5-2.9c-1 .6-2.1 1.1-3.3 1.5l-1.1 5.2h-6.2l-1.1-5.2c-1.2-.4-2.3-.9-3.3-1.5L12 43.1l-4.4-4.4 2.9-4.5c-.6-1-1.1-2.1-1.5-3.3l-5.2-1.1v-6.2L9 22.5c.4-1.2.9-2.3 1.5-3.3l-2.9-4.5 4.4-4.4 4.5 2.9c1-.6 2.1-1.1 3.3-1.5l1.1-5.2Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"/>
            <circle cx="24" cy="26.7" r="6" fill="none" stroke="currentColor" stroke-width="4"/>
          </svg>
        </span>
      </div>

      <p class="stockplace-403__code">Error 403</p>
      <h1 class="stockplace-403__title" id="stockplace-403-title">No tienes acceso a esta página</h1>
      <p class="stockplace-403__text">Esta sección está restringida o tu sesión no tiene los permisos necesarios. Si creés que deberías poder verla, probá iniciar sesión de nuevo o contactá al administrador.</p>

      <div class="stockplace-403__actions" aria-label="Acciones de la página 403">
        {% include "../components/01-atoms/button/button.twig" with {
          label: 'Volver al inicio',
          url: '/',
          variant: 'primary',
          extra_classes: 'stockplace-403__button'
        } only %}
        {% include "../components/01-atoms/button/button.twig" with {
          label: 'Iniciar sesión',
          url: '/user/login',
          variant: 'secondary',
          extra_classes: 'stockplace-403__button'
        } only %}
      </div>
    </section>
  </main>
</div>
