{{ attach_library('caaf/password-recovery') }}
{{ page.header }}
<main class="password-recovery" role="main">
  <a id="main-content" tabindex="-1"></a>
  <div class="password-recovery__inner">
    <h1 class="password-recovery__title">Cambiar contraseña</h1>
    <p class="password-recovery__description">Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.</p>
    {% if page.status %}<div class="password-recovery__messages" role="status">{{ page.status }}</div>{% endif %}
    {{ page.content }}
    <a class="password-recovery__back" href="{{ path('user.login') }}">Regresar al inicio de sesión</a>
  </div>
</main>
{{ page.footer }}
